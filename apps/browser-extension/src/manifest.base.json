{
  "manifest_version": 3,
  "name": "LinkGlimpse – Social Preview Checker",
  "version": "0.1.0",
  "description": "Check the current page's social cards, Google search preview, metadata, share image, redirects, and indexing signals.",
  "homepage_url": "https://www.linkglimpse.com/",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkglimpse.com/*"
  ],
  "action": {
    "default_title": "Check this page with LinkGlimpse",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
