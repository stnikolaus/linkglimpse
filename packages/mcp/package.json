{
  "name": "linkglimpse-mcp",
  "version": "0.1.0",
  "description": "MCP server for visual social preview, Open Graph, SERP, image, redirect, and indexing audits.",
  "type": "module",
  "bin": {
    "linkglimpse-mcp": "src/server.mjs"
  },
  "exports": {
    ".": "./src/server.mjs"
  },
  "files": [
