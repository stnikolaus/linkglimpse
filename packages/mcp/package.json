  "repository": {
    "type": "git",
    "url": "git+https://github.com/stnikolaus/linkglimpse.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://www.linkglimpse.com/",
  "bugs": "https://github.com/stnikolaus/linkglimpse/issues",
  "license": "AGPL-3.0-or-later",
  "mcpName": "io.github.stnikolaus/linkglimpse",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "linkglimpse": "^0.2.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
